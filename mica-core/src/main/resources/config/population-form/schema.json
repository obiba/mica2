              },
              {
                "const": "second_trimester",
                "title": "t(study_taxonomy.vocabulary.populations-selectionCriteria-pregnantWomen.term.second_trimester.title)"
              },
              {
                "const": "third_trimester",
                "title": "t(study_taxonomy.vocabulary.populations-selectionCriteria-pregnantWomen.term.third_trimester.title)"
