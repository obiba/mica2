              {
                "const": "clinic_patients",
                "title": "t(study_taxonomy.vocabulary.populations-recruitment-specificPopulationSources.term.clinic_patients.title)"
              },
              {
                "const": "specific_association",
                "title": "t(study_taxonomy.vocabulary.populations-recruitment-specificPopulationSources.term.specific_association.title)"
              },
              {
                "const": "other",
                "title": "t(study_taxonomy.vocabulary.populations-recruitment-specificPopulationSources.term.other.title)"
