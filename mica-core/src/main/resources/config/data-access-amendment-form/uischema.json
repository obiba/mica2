{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Label",
      "text": "<h2>t(data-access-amendment.default.form-title)</h2>"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Label",
          "text": "<h3>t(data-access-amendment.default.modification-nature-title)</h3>"
        },
        {
          "type": "Control",
          "scope": "#/properties/modificationNature",
          "label": false,
          "options": {
            "format": "checkbox"
          }
        }
      ]
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Label",
          "text": "<h3>A. t(data-access-amendment.default.I.A.title)</h3><p class='help-block'>t(data-access-request.default.I.A.info)</p>"
        },
        {
          "type": "VerticalLayout",
          "elements": [
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/name"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/title"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/position"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/institution"
                }
              ],
              "options": {
                "class": "col-6"
              }
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/email"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/emailAlt"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/phone"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/mailingAddress",
                  "options": {
                    "rows": 3
                  }
                }
              ],
              "options": {
                "class": "col-6"
              }
            }
          ],
          "options": {
            "class": "row q-col-gutter-md"
          }
        }
      ],
      "rules": {
        "visible": "contains(modificationNature, \"IA\")"
      }
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Label",
          "text": "<h3>B. t(data-access-amendment.default.I.B.title)</h3><p class='help-block'>t(data-access-amendment.default.I.B.info)</p>"
        },
        {
          "type": "VerticalLayout",
          "elements": [
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/repName"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/repTitle"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/repPosition"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/repInstitution"
                }
              ],
              "options": {
                "class": "col-6"
              }
            },
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/repEmail"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/repPhone"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/repMailingAddress",
                  "options": {
                    "rows": 3
                  }
                }
              ],
              "options": {
                "class": "col-6"
              }
            }
          ],
          "options": {
            "class": "row q-col-gutter-md"
          }
        }
      ],
      "rules": {
        "visible": "contains(modificationNature, \"IB\")"
      }
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Label",
          "text": "<h3>C. t(data-access-amendment.default.I.C.title)</h3>"
        },
        {
          "type": "Control",
          "scope": "#/properties/projectTitle",
          "label": false,
          "options": {
            "rows": 3
          }
        },
        {
          "type": "VerticalLayout",
          "elements": [
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/projectWebsite",
                  "hint": "t(data-access-amendment.default.I.C.website-help)"
                }
              ],
              "options": {
                "class": "col-6"
              }
            },
            {
              "type": "VerticalLayout",
              "elements": [],
              "options": {
                "class": "col-6"
              }
            }
          ],
          "options": {
            "class": "row q-col-gutter-md"
          }
        }
      ],
      "rules": {
        "visible": "contains(modificationNature, \"IC\")"
      }
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Label",
          "text": "<h3>D. t(data-access-amendment.default.I.D.title)</h3><p class='help-block'>t(data-access-amendment.default.I.D.info)</p>"
        },
        {
          "type": "VerticalLayout",
          "elements": [
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/hasNoStaff"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/staff",
                  "label": false,
                  "options": {
                    "addLabel": "New",
                    "items": {
                      "type": "VerticalLayout",
                      "elements": [
                        {
                          "type": "Control",
                          "scope": "#/properties/name"
                        },
                        {
                          "type": "Control",
                          "scope": "#/properties/title"
                        },
                        {
                          "type": "Control",
                          "scope": "#/properties/position"
                        },
                        {
                          "type": "Control",
                          "scope": "#/properties/email"
                        }
                      ]
                    }
                  },
                  "rules": {
                    "visible": "!hasNoStaff"
                  }
                }
              ],
              "options": {
                "class": "col-6"
              }
            },
            {
              "type": "VerticalLayout",
              "elements": [],
              "options": {
                "class": "col-6"
              }
            }
          ],
          "options": {
            "class": "row q-col-gutter-md"
          }
        }
      ],
      "rules": {
        "visible": "contains(modificationNature, \"ID\")"
      }
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Label",
          "text": "<h3>E. t(data-access-amendment.default.I.E.title)</h3><p class='help-block'>t(data-access-amendment.default.I.E.info)</p>"
        },
        {
          "type": "VerticalLayout",
          "elements": [
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/hasNoStudents"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/students",
                  "label": false,
                  "options": {
                    "addLabel": "New",
                    "items": {
                      "type": "VerticalLayout",
                      "elements": [
                        {
                          "type": "Control",
                          "scope": "#/properties/name"
                        },
                        {
                          "type": "Control",
                          "scope": "#/properties/title"
                        },
                        {
                          "type": "Control",
                          "scope": "#/properties/position"
                        },
                        {
                          "type": "Control",
                          "scope": "#/properties/email"
                        }
                      ]
                    }
                  },
                  "rules": {
                    "visible": "!hasNoStudents"
                  }
                }
              ],
              "options": {
                "class": "col-6"
              }
            },
            {
              "type": "VerticalLayout",
              "elements": [],
              "options": {
                "class": "col-6"
              }
            }
          ],
          "options": {
            "class": "row q-col-gutter-md"
          }
        }
      ],
      "rules": {
        "visible": "contains(modificationNature, \"IE\")"
      }
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Label",
          "text": "<h3>F. t(data-access-amendment.default.I.F.title)</h3><p class='help-block'>t(data-access-amendment.default.I.F.info)</p>"
        },
        {
          "type": "Control",
          "scope": "#/properties/abstract",
          "label": false,
          "options": {
            "rows": 3,
            "wordLimit": "0:500",
            "validationMessage": {
              "wordLimitError": "The 500 words limit has been exceeded."
            }
          }
        }
      ],
      "rules": {
        "visible": "contains(modificationNature, \"IF\")"
      }
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Label",
          "text": "<h3>G. t(data-access-amendment.default.I.G.title)</h3><p class='help-block'>t(data-access-amendment.default.I.G.info)</p>"
        },
        {
          "type": "Control",
          "scope": "#/properties/summary",
          "label": false,
          "options": {
            "rows": 3,
            "wordLimit": "0:200",
            "validationMessage": {
              "wordLimitError": "The 200 words limit has been exceeded."
            }
          }
        }
      ],
      "rules": {
        "visible": "contains(modificationNature, \"IG\")"
      }
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Label",
          "text": "<h3>G. t(data-access-amendment.default.I.H.title)</h3><p class='help-block'>t(data-access-amendment.default.I.H.info)</p>"
        },
        {
          "type": "Control",
          "scope": "#/properties/endDate",
          "label": false,
          "options": {
            "validationMessage": "t(data-access-amendment.default.date-error)",
            "dateOptions": {
              "dateFormat": "yyyy-MM-dd"
            }
          }
        }
      ],
      "rules": {
        "visible": "contains(modificationNature, \"IH\")"
      }
    },
    {
      "type": "Label",
      "text": "<h2>II - t(data-access-amendment.default.documents.title)</h2>",
      "rules": {
        "visible": "contains(modificationNature, \"IIrdRebResearchProtocol\") || contains(modificationNature, \"IIrdRebDecisionLetter\") || contains(modificationNature, \"IIrdCV\") || contains(modificationNature, \"IIrdPeerReview\")"
      }
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/rdRebResearchProtocol",
          "options": {
            "emptyMessage": "t(data-access-request.no-documents)",
            "validationMessage": {
              "missingFiles": "t(missing-files)",
              "minItems": "t(min-items)"
            }
          },
          "rules": {
            "visible": "contains(modificationNature, \"IIrdRebResearchProtocol\")"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/rdRebDecisionLetter",
          "options": {
            "emptyMessage": "t(data-access-request.no-documents)",
            "validationMessage": {
              "missingFiles": "t(missing-files)",
              "minItems": "t(min-items)"
            }
          },
          "rules": {
            "visible": "contains(modificationNature, \"IIrdRebDecisionLetter\")"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/rdCV",
          "options": {
            "emptyMessage": "t(data-access-request.no-documents)",
            "validationMessage": {
              "missingFiles": "t(missing-files)",
              "minItems": "t(min-items)"
            }
          },
          "rules": {
            "visible": "contains(modificationNature, \"IIrdCV\")"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/rdPeerReview",
          "options": {
            "emptyMessage": "t(data-access-request.no-documents)",
            "validationMessage": {
              "missingFiles": "t(missing-files)",
              "minItems": "t(min-items)"
            }
          },
          "rules": {
            "visible": "contains(modificationNature, \"IIrdPeerReview\")"
          }
        }
      ]
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/other",
          "options": {
            "rows": 5,
            "wordLimit": "0:500",
            "validationMessage": {
              "wordLimitError": "The 500 words limit has been exceeded."
            }
          }
        }
      ],
      "rules": {
        "visible": "contains(modificationNature, \"other\")"
      }
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Label",
          "text": "<h3>t(data-access-amendment.default.signature.title)</h3>"
        },
        {
          "type": "Control",
          "scope": "#/properties/isFormCompleted"
        }
      ]
    }
  ]
}
