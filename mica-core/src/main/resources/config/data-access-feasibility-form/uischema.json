{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Label",
      "text": "label.1.text"
    },
    {
      "type": "Control",
      "scope": "#/properties/grantSubmission"
    },
    {
      "type": "HorizontalLayout",
      "options": {
        "class": "row q-col-gutter-md"
      },
      "rules": {
        "visible": "!!grantSubmission"
      },
      "elements": [
        {
          "type": "VerticalLayout",
          "options": {
            "class": "col-6"
          },
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/grantingAgency",
              "options": {
                "outlined": true,
                "dense": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/grantDate",
              "options": {
                "outlined": true,
                "dense": true,
                "validationMessage": "data-access-request.default.date-error",
                "dateOptions": {
                  "dateFormat": "yyyy-MM-dd"
                }
              }
            }
          ]
        },
        {
          "type": "VerticalLayout",
          "options": {
            "class": "col-6"
          },
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/grantCompetition",
              "options": {
                "outlined": true,
                "dense": true
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Label",
      "text": "label.2.text"
    },
    {
      "type": "HorizontalLayout",
      "options": {
        "class": "row q-col-gutter-md"
      },
      "elements": [
        {
          "type": "VerticalLayout",
          "options": {
            "class": "col-6"
          },
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/pi",
              "options": {
                "outlined": true,
                "dense": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/career",
              "options": {
                "format": "radio"
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/careerOther",
              "rules": {
                "visible": "career === \"other\""
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/currentPosition",
              "options": {
                "outlined": true,
                "dense": true
              }
            }
          ]
        },
        {
          "type": "VerticalLayout",
          "options": {
            "class": "col-6"
          },
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/piEmail",
              "options": {
                "outlined": true,
                "dense": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/piPhone",
              "options": {
                "outlined": true,
                "dense": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/piAddress",
              "options": {
                "rows": 3,
                "outlined": true,
                "dense": true
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Label",
      "text": "label.3.text"
    },
    {
      "type": "HorizontalLayout",
      "elements": [
        {
          "type": "VerticalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/projectTitle",
              "options": {
                "outlined": true,
                "dense": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/projectObjectives",
              "options": {
                "rows": 3,
                "outlined": true,
                "dense": true
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Label",
      "text": "label.4.text"
    },
    {
      "type": "HorizontalLayout",
      "elements": [
        {
          "type": "VerticalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/datasets",
              "options": {
                "rows": 3,
                "outlined": true,
                "dense": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/selectionCriteria",
              "options": {
                "rows": 3,
                "outlined": true,
                "dense": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/studyDesign",
              "options": {
                "rows": 3,
                "outlined": true,
                "dense": true
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Label",
      "text": "label.5.text"
    },
    {
      "type": "Control",
      "scope": "#/properties/includeBiospecimens"
    },
    {
      "type": "VerticalLayout",
      "rules": {
        "visible": "!!includeBiospecimens"
      },
      "elements": [
        {
          "type": "VerticalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/biospecimensType",
              "options": {
                "rows": 3,
                "outlined": true,
                "dense": true
              }
