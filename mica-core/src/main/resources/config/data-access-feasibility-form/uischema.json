{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Group",
      "elements": [
        {
          "type": "Label",
          "text": "t(label.1.text)"
        },
        {
          "type": "Control",
          "scope": "#/properties/grantSubmission"
        }
      ]
    },
    {
      "type": "Group",
      "rules": {
        "visible": "!!grantSubmission"
      },
      "elements": [
        {
          "type": "VerticalLayout",
          "options": {
            "class": "row q-col-gutter-md"
          },
          "elements": [
            {
              "type": "VerticalLayout",
              "options": {
                "class": "col-6"
              },
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/grantingAgency"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/grantDate",
                  "options": {
                    "validationMessage": "t(data-access-request.default.date-error)",
                    "dateOptions": {
                      "dateFormat": "yyyy-MM-dd"
                    }
                  }
                }
              ]
            },
            {
              "type": "VerticalLayout",
              "options": {
                "class": "col-6"
              },
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/grantCompetition"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Label",
          "text": "t(label.2.text)"
        }
      ]
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "VerticalLayout",
          "options": {
            "class": "row q-col-gutter-md"
          },
          "elements": [
            {
              "type": "VerticalLayout",
              "options": {
                "class": "col-6"
              },
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/pi"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/career",
                  "options": {
                    "format": "radio"
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/careerOther",
                  "rules": {
                    "visible": "career === \"other\""
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/currentPosition"
                }
              ]
            },
            {
              "type": "VerticalLayout",
              "options": {
                "class": "col-6"
              },
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/piEmail"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/piPhone"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/piAddress",
                  "options": {
                    "rows": 3
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Label",
          "text": "t(label.3.text)"
        }
      ]
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "VerticalLayout",
          "elements": [
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/projectTitle"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/projectObjectives",
                  "options": {
                    "rows": 3
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Label",
          "text": "t(label.4.text)"
        }
      ]
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "VerticalLayout",
          "elements": [
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/datasets",
                  "options": {
                    "rows": 3
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/selectionCriteria",
                  "options": {
                    "rows": 3
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/studyDesign",
                  "options": {
                    "rows": 3
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Label",
          "text": "t(label.5.text)"
        },
        {
          "type": "Control",
          "scope": "#/properties/includeBiospecimens"
        }
      ]
    },
    {
      "type": "Group",
      "rules": {
        "visible": "!!includeBiospecimens"
      },
      "elements": [
        {
          "type": "VerticalLayout",
          "elements": [
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/biospecimensType",
                  "options": {
                    "rows": 3
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/biospecimensSelectionCriteria",
                  "options": {
                    "rows": 3
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/biospecimensPreAnalyticalCharacteristics",
                  "options": {
                    "rows": 3
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/biospecimensAnalyzeMethods",
                  "options": {
                    "rows": 3
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Label",
          "text": "t(label.6.text)"
        }
      ]
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "VerticalLayout",
          "elements": [
            {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/linkage",
                  "options": {
                    "rows": 3
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
