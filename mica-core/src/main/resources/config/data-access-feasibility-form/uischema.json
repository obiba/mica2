            {
              "type": "Control",
              "scope": "#/properties/biospecimensSelectionCriteria",
              "options": {
                "rows": 3,
                "outlined": true,
                "dense": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/biospecimensPreAnalyticalCharacteristics",
              "options": {
                "rows": 3,
                "outlined": true,
                "dense": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/biospecimensAnalyzeMethods",
              "options": {
                "rows": 3,
                "outlined": true,
                "dense": true
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Label",
      "text": "label.6.text"
    },
    {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "VerticalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/linkage",
              "options": {
                "rows": 3,
                "outlined": true,
                "dense": true
              }
            }
          ]
        }
      ]
    }
  ]
}
