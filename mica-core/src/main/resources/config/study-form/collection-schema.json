{
  "type": "object",
  "properties": {
    "website": {
      "title": "t(website)",
      "type": "string",
      "pattern": "^https?://\\S+$"
    },
    "funding": {
      "type": "object",
      "format": "localizedString",
      "title": "t(funding)"
    },
    "info": {
      "type": "object",
      "format": "localizedString",
      "title": "t(suppl-info)"
    },
    "methods": {
      "type": "object",
      "title": "t(study.design)",
      "properties": {
        "design": {
          "type": "string",
          "title": "t(study_taxonomy.vocabulary.methods-design.title)",
          "oneOf": [
            {
              "const": "cohort_study",
              "title": "t(study_taxonomy.vocabulary.methods-design.term.cohort_study.title)"
            },
            {
              "const": "case_control",
              "title": "t(study_taxonomy.vocabulary.methods-design.term.case_control.title)"
            },
            {
              "const": "case_only",
              "title": "t(study_taxonomy.vocabulary.methods-design.term.case_only.title)"
            },
            {
              "const": "cross_sectional",
              "title": "t(study_taxonomy.vocabulary.methods-design.term.cross_sectional.title)"
            },
            {
              "const": "clinical_trial",
              "title": "t(study_taxonomy.vocabulary.methods-design.term.clinical_trial.title)"
            },
            {
              "const": "other",
              "title": "t(study_taxonomy.vocabulary.methods-design.term.other.title)"
            }
          ]
        },
        "otherDesign": {
          "type": "object",
          "format": "localizedString",
          "title": "t(study.other-design)"
        },
        "followUpInfo": {
          "type": "object",
          "format": "localizedString",
          "title": "t(study.follow-up)"
        },
        "recruitments": {
          "type": "array",
          "items": {
            "type": "string",
            "oneOf": [
              {
                "const": "individuals",
                "title": "t(study_taxonomy.vocabulary.methods-recruitments.term.individuals.title)"
              },
              {
                "const": "families",
                "title": "t(study_taxonomy.vocabulary.methods-recruitments.term.families.title)"
              },
              {
                "const": "other",
                "title": "t(study_taxonomy.vocabulary.methods-recruitments.term.other.title)"
              }
            ]
          },
          "title": "t(study.recruitment-sources.label)",
          "uniqueItems": true
        },
        "otherRecruitment": {
          "type": "object",
          "format": "localizedString",
          "title": "t(study.recruitment-sources.other)"
        },
        "info": {
          "type": "object",
          "format": "localizedString",
          "title": "t(suppl-info)"
        }
      }
    },
    "numberOfParticipants": {
      "type": "object",
      "properties": {
        "participant": {
          "type": "object",
          "properties": {
            "number": {
              "type": "number",
              "title": "t(numberOfParticipants.participants)"
            },
            "noLimit": {
              "type": "boolean",
              "title": "t(numberOfParticipants.no-limit)"
            }
          }
        },
        "sample": {
          "type": "object",
          "properties": {
            "number": {
              "type": "number",
              "title": "t(numberOfParticipants.sample)"
            },
            "noLimit": {
              "type": "boolean",
              "title": "t(numberOfParticipants.no-limit)"
            }
          }
        },
        "info": {
          "type": "object",
          "format": "localizedString",
          "title": "t(numberOfParticipants.suppl-info)"
        }
      },
      "title": "t(numberOfParticipants.label)"
    },
    "startYear": {
      "type": "integer",
      "title": "t(study.start-year)"
    },
    "endYear": {
      "type": "integer",
      "title": "t(study.end-year)"
    },
    "access": {
      "type": "object",
      "format": "radioGroupCollection",
      "values": [
        {
          "key": "yes",
          "caption": "t(global.yes)"
        },
        {
          "key": "no",
          "caption": "t(global.no)"
        },
        {
          "key": "na",
          "caption": "t(global.not-applicable)"
        }
      ],
      "items": [
        {
          "key": "access_data",
          "name": "t(study_taxonomy.vocabulary.access_data.title)"
        },
        {
          "key": "access_bio_samples",
          "name": "t(study_taxonomy.vocabulary.access_bio_samples.title)"
        },
        {
          "key": "access_other",
          "name": "t(study_taxonomy.vocabulary.access_other.title)"
