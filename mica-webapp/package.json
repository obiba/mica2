{
  "name": "mica",
  "version": "0.0.0",
  "description": "Description for mica",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@obiba/quasar-ui-json-form": "^0.7.3",
    "@popperjs/core": "^2.11.8",
    "@quasar/extras": "^1.18.0",
    "@vue/compat": "^3.4.0",
    "admin-lte": "^4.0.0-rc4",
    "axios": "^1.18.0",
    "bootstrap": "^5.3.3",
    "bootstrap-4-autocomplete": "^1.3.2",
    "bootstrap-datepicker": "^1.9.0",
    "chart.js": "^4.4.6",
    "chartjs-chart-geo": "^4.3.3",
    "d3": "3.5.5",
    "datatables.net": "^1.13.11",
    "datatables.net-bs5": "^1.13.11",
    "datatables.net-buttons": "^2.4.3",
    "datatables.net-buttons-bs5": "^2.4.3",
    "datatables.net-fixedheader": "^3.4.0",
    "datatables.net-fixedheader-bs5": "^3.4.0",
    "datatables.net-select": "^1.7.0",
    "datatables.net-select-bs5": "^1.7.0",
    "dompurify": "^3.4.15",
    "jquery": "^3.7.1",
    "jquery.redirect": "^1.1.4",
    "js-cookie": "^3.0.7",
    "marked": "^15.0.6",
    "mica-study-timeline": "github:obiba/mica-study-timeline#1.2.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.47",
    "plotly.js-dist-min": "^2.5.1",
    "quasar": "^2.33.0",
    "rql": "github:epigeny/rql#1.1.0",
    "select2": "^4.1.0-rc.0",
    "select2-bootstrap-5-theme": "^1.3.0",
    "simplemde": "^1.11.2",
    "toastr": "^2.1.4",
    "vue": "^3.4.0",
    "vue-i18n": "^11.4.12"
  },
  "scripts": {
    "build:css": "sass --quiet-deps --style=compressed --source-map --load-path=node_modules src/main/resources/scss/mica.scss src/main/webapp/assets/css/mica.min.css",
    "build:css:prod": "sass --quiet-deps --style=compressed --no-source-map --load-path=node_modules src/main/resources/scss/mica.scss src/main/webapp/assets/css/mica.min.css",
    "watch:css": "sass --quiet-deps --watch --source-map --load-path=node_modules src/main/resources/scss/mica.scss src/main/webapp/assets/css/mica.min.css",
    "build:forms": "vite build --config vite.forms.config.mjs",
    "watch:forms": "vite build --config vite.forms.config.mjs --watch",
    "test:forms": "vitest run --config vitest.forms.config.mjs"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^1.12.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "postcss-prefix-selector": "^2.2.1",
    "sass": "^1.93.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
