<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.obiba.mica</groupId>
    <artifactId>mica</artifactId>
    <version>7.0-SNAPSHOT</version>
    <relativePath>../</relativePath>
  </parent>

  <artifactId>mica-webapp</artifactId>
  <packaging>war</packaging>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- -DskipTests also skips the data access form bundle tests -->
    <skipTests>false</skipTests>
  </properties>

  <dependencies>

    <dependency>
      <groupId>org.obiba.mica</groupId>
      <artifactId>mica-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.obiba.mica</groupId>
      <artifactId>mica-web-model</artifactId>
    </dependency>
    <dependency>
      <groupId>org.obiba.mica</groupId>
      <artifactId>mica-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>org.obiba.commons</groupId>
      <artifactId>obiba-oidc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.obiba.commons</groupId>
      <artifactId>obiba-shiro</artifactId>
    </dependency>
    <dependency>
      <groupId>org.obiba.commons</groupId>
      <artifactId>obiba-shiro-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.obiba.commons</groupId>
      <artifactId>obiba-security</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.shiro</groupId>
      <artifactId>shiro-web</artifactId>
      <classifier>jakarta</classifier>
    </dependency>

    <dependency>
      <groupId>org.owasp.esapi</groupId>
      <artifactId>esapi</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-tomcat</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-to-slf4j</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.freemarker</groupId>
      <artifactId>freemarker</artifactId>
    </dependency>


    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-freemarker</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.java-diff-utils</groupId>
      <artifactId>java-diff-utils</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jetty</artifactId>
    </dependency>

    <dependency>
      <groupId>org.eclipse.jetty.ee11</groupId>
      <artifactId>jetty-ee11-servlets</artifactId>
    </dependency>

    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-clean-plugin</artifactId>
        <configuration>
          <filesets>
            <fileset>
              <directory>node_modules</directory>
            </fileset>
            <fileset>
              <directory>src/main/webapp/assets/libs/node_modules</directory>
            </fileset>
            <fileset>
              <directory>src/main/webapp/assets/css</directory>
              <includes>
                <include>*.min.css</include>
                <include>*.map</include>
              </includes>
            </fileset>
            <fileset>
              <directory>src/main/webapp/assets/js/data-access-form</directory>
            </fileset>
          </filesets>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>${frontend-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>install node and npm</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
            <configuration>
              <nodeVersion>v24.11.0</nodeVersion>
            </configuration>
          </execution>
          <execution>
            <id>npm install</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>install --include=dev</arguments>
            </configuration>
          </execution>
          <execution>
            <!-- data access form bundle (Vue + Quasar json-form), see src/main/vue/data-access-form -->
            <id>npm build forms</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>run build:forms</arguments>
            </configuration>
          </execution>
          <execution>
            <!-- unit tests of the data access form bundle, skipped with -DskipTests -->
            <id>npm test forms</id>
            <phase>test</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>run test:forms</arguments>
              <skipTests>${skipTests}</skipTests>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <!-- the libraries of the public portal pages -->
            <id>copy js deps</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>src/main/webapp/assets/libs/node_modules</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>node_modules</directory>
                  <includes>
                    <include>admin-lte/dist/**</include>
                    <include>bootstrap/dist/**</include>
                    <include>@popperjs/core/dist/**</include>
                    <include>@fortawesome/fontawesome-free/**</include>
                    <include>jquery/dist/**</include>
                    <include>moment/min/**</include>
                    <include>moment-timezone/builds/**</include>
                    <include>chart.js/dist/**</include>
                    <include>datatables.net/js/**</include>
                    <include>datatables.net-bs5/js/**</include>
                    <include>datatables.net-bs5/css/**</include>
                    <include>datatables.net-buttons/js/**</include>
                    <include>datatables.net-buttons-bs5/js/**</include>
                    <include>datatables.net-buttons-bs5/css/**</include>
                    <include>datatables.net-select/js/**</include>
                    <include>datatables.net-select-bs5/js/**</include>
                    <include>datatables.net-select-bs5/css/**</include>
                    <include>datatables.net-fixedheader/js/**</include>
                    <include>datatables.net-fixedheader-bs5/js/**</include>
                    <include>datatables.net-fixedheader-bs5/css/**</include>
                    <include>select2/dist/**</include>
                    <include>select2-bootstrap-5-theme/dist/**</include>
                    <include>toastr/build/**</include>
                    <include>simplemde/dist/**</include>
                    <include>vue/dist/**</include>
                    <include>rql/dist/**</include>
                    <include>plotly.js-dist-min/**</include>
                    <include>axios/dist/**</include>
                    <include>dompurify/dist/**</include>
                    <include>marked/**</include>
                    <include>jquery.redirect/**</include>
                    <include>js-cookie/**</include>
                    <include>bootstrap-datepicker/dist/**</include>
                    <include>bootstrap-4-autocomplete/dist/**</include>
                    <include>chartjs-chart-geo/build/**</include>
                    <include>d3/d3.min.js</include>
                    <include>mica-study-timeline/dist/**</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy ui content</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>target/classes/static/admin</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>../mica-ui/dist/spa</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!--
        Ensure frontend assets are always built
       -->
      <id>build-frontend</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>exec-npm-install</id>
                <phase>generate-sources</phase>
                <configuration>
                  <executable>npm</executable>
                  <arguments>
                    <argument>install</argument>
                  </arguments>
                </configuration>
                <goals>
                  <goal>exec</goal>
                </goals>
              </execution>
              <execution>
                <id>exec-npm-build-css</id>
                <phase>generate-sources</phase>
                <configuration>
                  <executable>npm</executable>
                  <arguments>
                    <argument>run</argument>
                    <argument>build:css</argument>
                  </arguments>
                </configuration>
                <goals>
                  <goal>exec</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!--
        Add config files to classpath in order to run application from maven:
        mvn spring-boot:run -Pdev
       -->
      <id>dev</id>
      <build>
        <resources>
          <resource>
            <directory>src/main/resources</directory>
            <filtering>true</filtering>
            <includes>
              <include>**/*</include>
            </includes>
            <excludes>
              <exclude>**/*.ftl</exclude>
            </excludes>
          </resource>
          <resource>
            <directory>src/main/conf</directory>
            <filtering>true</filtering>
            <includes>
              <include>**/*</include>
            </includes>
          </resource>
        </resources>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <configuration>
              <arguments>
                <argument>--spring.profiles.active=dev</argument>
              </arguments>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>js-compiled</id>
      <build>
        <resources>
          <resource>
            <directory>src/main/resources</directory>
            <filtering>true</filtering>
            <includes>
              <include>**/*</include>
            </includes>
            <excludes>
              <exclude>**/*.ftl</exclude>
            </excludes>
          </resource>
          <resource>
            <directory>src/main/conf</directory>
            <filtering>true</filtering>
            <includes>
              <include>**/*</include>
            </includes>
          </resource>
        </resources>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <configuration>
              <arguments>
                <argument>--spring.profiles.active=prod</argument>
              </arguments>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>exec-npm-install-prod</id>
                <phase>generate-sources</phase>
                <configuration>
                  <executable>npm</executable>
                  <arguments>
                    <argument>install</argument>
                    <argument>--include=dev</argument>
                  </arguments>
                </configuration>
                <goals>
                  <goal>exec</goal>
                </goals>
              </execution>
              <execution>
                <id>exec-npm-build-css-prod</id>
                <phase>generate-resources</phase>
                <configuration>
                  <executable>npm</executable>
                  <arguments>
                    <argument>run</argument>
                    <argument>build:css:prod</argument>
                  </arguments>
                </configuration>
                <goals>
                  <goal>exec</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <artifactId>maven-clean-plugin</artifactId>
            <configuration>
              <filesets>
                <fileset>
                  <directory>node_modules</directory>
                </fileset>
                <fileset>
                  <directory>src/main/webapp/assets/libs/node_modules</directory>
                </fileset>
                <fileset>
                  <directory>src/main/webapp/assets/css</directory>
                  <includes>
                    <include>*.min.css</include>
                    <include>*.map</include>
                  </includes>
                </fileset>
              </filesets>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

  </profiles>

</project>
